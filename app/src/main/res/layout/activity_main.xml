<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="16dp"
        android:text="@string/shizuku_connecting"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/shizukuButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Toolbar: view mode, capture, screen layout, keyboard. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/viewModeButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="View mode"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pin" />

        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Capture workspace"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_capture" />

        <ImageButton
            android:id="@+id/layoutButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Screen layout"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_layout" />

        <ImageButton
            android:id="@+id/screenHeightButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Screen size"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_screen_height" />

        <ImageButton
            android:id="@+id/keyboardButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Keyboard"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>

    <com.vspace.input.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/surface" />

    <!-- Raised by the keyboard toolbar button; the system IME types into it. -->
    <EditText
        android:id="@+id/keyboardField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/surface"
        android:hint="@string/keyboard_hint"
        android:inputType="textNoSuggestions"
        android:padding="14dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:visibility="gone" />

</LinearLayout>
