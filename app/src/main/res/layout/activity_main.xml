<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="16dp"
        android:text="@string/shizuku_connecting"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/shizukuButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <com.vspace.input.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="@color/surface" />

    <Button
        android:id="@+id/viewModeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" />

    <Button
        android:id="@+id/captureButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/capture_button" />

    <TextView
        android:id="@+id/appsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/apps_header"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:divider="@color/bg"
        android:dividerHeight="1dp" />

</LinearLayout>
