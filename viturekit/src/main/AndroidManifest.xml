<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- VITURE glasses attach over USB. Declared optional so the library can be
         vendored into apps that also run on devices without USB-host support. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

</manifest>
