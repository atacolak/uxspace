<?xml version="1.0" encoding="utf-8"?>
<!--
    UxSpace's accessibility service config. We only need focus events on any window
    so we can spot when an EditText (or other text-input) on one of our virtual
    displays gains focus, and pop up the phone-side keyboard for the user to type.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="50" />
